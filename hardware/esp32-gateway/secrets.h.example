#pragma once
// -----------------------------------------------------------------------------
// Copy this file to "secrets.h" (same folder) and fill in your real values.
//   secrets.h is git-ignored, so your WiFi password and ingest token are NEVER
//   committed or pushed. esp32-gateway.ino includes it automatically.
// -----------------------------------------------------------------------------
#define SECRET_WIFI_SSID    "YOUR_WIFI_NAME"       // 2.4 GHz network (ESP32 has no 5 GHz)
#define SECRET_WIFI_PASS    "YOUR_WIFI_PASSWORD"
#define SECRET_INGEST_TOKEN "PASTE_YOUR_HORUS_INGEST_TOKEN"
