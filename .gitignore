# Python
__pycache__/
*.py[cod]
venv/
.venv/
env/

# Secrets & local config
.env

# SQLite database (and WAL/SHM sidecar files) — never commit operational data
horus.db
*.db
*.db-wal
*.db-shm

# Hardware secrets (WiFi creds, ingest token) — keep these local only
hardware/**/secrets.h

# Android app build artifacts / local config
android/**/build/
android/**/.gradle/
android/**/local.properties
android/**/.idea/
android/**/.cxx/
*.apk
*.aab
*.iml

# Stray screenshots dropped in the project root
*.jpeg
*.jpg
*.png
