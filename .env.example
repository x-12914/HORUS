# Defense-LOG configuration — copy to .env and fill in (or set these in the
# systemd unit). Do NOT commit the real .env.

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DEFENSELOG_SECRET_KEY=

# Absolute path to the SQLite database file.
DEFENSELOG_DB=/opt/defenselog/defense_log.db

# Set to 1 only when the app is served over HTTPS (enables Secure cookies).
DEFENSELOG_HTTPS=0

# Local dev server only (ignored under Gunicorn):
DEFENSELOG_HOST=127.0.0.1
DEFENSELOG_PORT=5000
DEFENSELOG_DEBUG=1
