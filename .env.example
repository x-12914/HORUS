# HORUS configuration — copy to .env and fill in (or set these in the
# systemd unit). Do NOT commit the real .env.

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
HORUS_SECRET_KEY=

# Absolute path to the SQLite database file.
HORUS_DB=/opt/horus/horus.db

# Set to 1 only when the app is served over HTTPS (enables Secure cookies).
HORUS_HTTPS=0

# Shared token for the BLE tracking ingestion endpoint (/api/track).
# Leave blank to keep the endpoint disabled until the hardware is ready.
HORUS_INGEST_TOKEN=

# Shared enrolment token for the Defense Alert phone API (/api/alerts/register).
# Leave blank to disable self-enrolment (phones can still be added in the UI).
HORUS_ALERT_TOKEN=

# Local dev server only (ignored under Gunicorn):
HORUS_HOST=127.0.0.1
HORUS_PORT=5000
HORUS_DEBUG=1
