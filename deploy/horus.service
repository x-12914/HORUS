# systemd unit for HORUS (Gunicorn).
# Install:
#   sudo cp deploy/horus.service /etc/systemd/system/horus.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now horus
# Inspect:
#   systemctl status horus
#   journalctl -u horus -f
#
# Adjust User, WorkingDirectory, the venv path and the bind port to match
# your VPS. Pick a port that nothing else on the box is already using.

[Unit]
Description=HORUS — Historical Operations Record & Unified Storage
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/horus

# --- Required secrets / config ---
# Generate the key with: python -c "import secrets; print(secrets.token_hex(32))"
Environment="HORUS_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_VALUE"
Environment="HORUS_DB=/opt/horus/horus.db"
# Set to 1 only once TLS terminates in front of the app (secure cookies).
Environment="HORUS_HTTPS=0"

# Bind directly to a free port for now. Switch 0.0.0.0 -> 127.0.0.1 later if
# you put it behind your existing Nginx instead of exposing the port.
ExecStart=/opt/horus/venv/bin/gunicorn \
    --workers 3 \
    --bind 0.0.0.0:8050 \
    --preload \
    --access-logfile - \
    --error-logfile - \
    wsgi:app

Restart=always
RestartSec=3

# --- Light hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
